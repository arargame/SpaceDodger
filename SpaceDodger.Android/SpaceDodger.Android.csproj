<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Play Console: API 36 (Android 16) zorunlulugu -->
    <TargetFramework>net9.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidMinimumDotNetApiLevel>24</AndroidMinimumDotNetApiLevel>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <!-- Play Store & Cihaz Uyumlulugu: Samsung A10 gibi 32-bit (ARM) ve modern 64-bit cihazlari destekle -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpaceDodger.Droid</RootNamespace>
    <ApplicationId>com.arargames.spacedodger</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- ===================== DEBUG ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <!-- ===================== RELEASE ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Linker: Sdk kütüphanelerini kırp, MonoGame assembly'lerini koru -->
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkSkip>MonoGame.Framework;Xamarin.GooglePlayServices.Ads.Lite;Xamarin.GooglePlayServices.Basement;Xamarin.Android.Google.BillingClient;Xamarin.GooglePlayServices.Games.V2;Xamarin.Firebase.Analytics</AndroidLinkSkip>

    <!-- AOT: Kapali (Windows AOT derleme MonoAOTCompiler cakismalarini engeller) -->
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- R8 shrinker aktif, Proguard kapalı -->
    <AndroidEnableR8>true</AndroidEnableR8>
    <AndroidEnableProguard>false</AndroidEnableProguard>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.4.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="124.0.0.5" />
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="8.1.0" />
    <PackageReference Include="Xamarin.GooglePlayServices.Games.V2" Version="119.0.0" />
    <PackageReference Include="Xamarin.Firebase.Analytics" Version="123.0.0.3" />
    <PackageReference Include="Xamarin.GooglePlayServices.Basement" Version="118.10.0.1" />
  </ItemGroup>

  <!-- Firebase configuration: google-services.json is processed when provided in project root -->
  <ItemGroup Condition="Exists('google-services.json')">
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>

  <Import Project="..\SpaceDodger.Shared\SpaceDodger.Shared.projitems" Label="Shared" />

  <!-- Same raw content as desktop, bundled as Android assets.
       TitleContainer resolves "Content/..." inside the APK assets. -->
  <ItemGroup>
    <AndroidAsset Include="..\Content\**\*.*" Link="Assets\Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- AutoVersion: Tarih tabanli otomatik versiyon kodu olusturucu -->
  <Target Name="AutoVersion" BeforeTargets="BeforeBuild" Condition="'$(AutoVersionSet)' != 'true'">
    <PropertyGroup>
      <ApplicationVersion>$([System.DateTime]::Now.ToString('yy').Substring(1))$([System.DateTime]::Now.ToString('MMddHHmm'))</ApplicationVersion>
      <AutoVersionSet>true</AutoVersionSet>
    </PropertyGroup>
    <Message Importance="High" Text="[AutoVersion] Version Code SET (tek sefer): $(ApplicationVersion)" />
  </Target>
</Project>
