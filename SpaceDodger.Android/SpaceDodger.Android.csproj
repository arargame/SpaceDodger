<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Play Console: API 36 (Android 16) zorunlulugu -->
    <TargetFramework>net9.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <!-- Play Store & Cihaz Uyumlulugu: Samsung A10 gibi 32-bit (ARM) ve modern 64-bit cihazlari destekle -->
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpaceDodger.Droid</RootNamespace>
    <ApplicationId>com.arargames.spacedodger</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- ===================== DEBUG ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <!-- ===================== RELEASE ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Linker: Sdk kütüphanelerini kırp, MonoGame assembly'lerini koru -->
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkSkip>MonoGame.Framework</AndroidLinkSkip>

    <!-- AOT: Kapali (Windows AOT derleme MonoAOTCompiler cakismalarini engeller) -->
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- R8 shrinker aktif, Proguard kapalı -->
    <AndroidEnableR8>true</AndroidEnableR8>
    <AndroidEnableProguard>false</AndroidEnableProguard>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.4.1" />
  </ItemGroup>

  <Import Project="..\SpaceDodger.Shared\SpaceDodger.Shared.projitems" Label="Shared" />

  <!-- Same raw content as desktop, bundled as Android assets.
       TitleContainer resolves "Content/..." inside the APK assets. -->
  <ItemGroup>
    <AndroidAsset Include="..\Content\**\*.*" Link="Assets\Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
