<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SpaceDodger.Droid</RootNamespace>
    <ApplicationId>com.koray.spacedodger</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- ===================== DEBUG ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>

  <!-- ===================== RELEASE ===================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidFastDeployment>false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!-- Linker: Sdk kütüphanelerini kırp, MonoGame assembly'lerini koru -->
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkSkip>MonoGame.Framework</AndroidLinkSkip>

    <!-- AOT: ARM64 cihazlarda yüksek performans sağlar -->
    <RunAOTCompilation>true</RunAOTCompilation>

    <!-- R8 shrinker aktif, Proguard kapalı -->
    <AndroidEnableR8>true</AndroidEnableR8>
    <AndroidEnableProguard>false</AndroidEnableProguard>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.2.1105" />
  </ItemGroup>

  <Import Project="..\SpaceDodger.Shared\SpaceDodger.Shared.projitems" Label="Shared" />

  <!-- Same raw content as desktop, bundled as Android assets.
       TitleContainer resolves "Content/..." inside the APK assets. -->
  <ItemGroup>
    <AndroidAsset Include="..\Content\**\*.*" Link="Assets\Content\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
